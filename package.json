{
  "name": "auth-sdk-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:contracts": "pnpm --filter @eva_solutions/auth-contracts run build",
    "type-check": "pnpm run build:contracts && pnpm -r type-check",
    "test:run": "pnpm run build:contracts && pnpm -r test:run",
    "test:types": "pnpm run build:contracts && pnpm -r --if-present test:types",
    "lint": "oxlint .",
    "fmt": "oxfmt --write packages/auth-sdk/src packages/auth-sdk/tests packages/auth-contracts/src packages/auth-contracts/tests",
    "fmt:check": "oxfmt --check packages/auth-sdk/src packages/auth-sdk/tests packages/auth-contracts/src packages/auth-contracts/tests",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "oxfmt": "0.44.0",
    "oxlint": "^1.65.0"
  }
}
