{
  "name": "@eva_solutions/auth-sdk",
  "version": "2.0.1",
  "description": "Official TypeScript client for the EVA Auth Service — secure cookie-based auth with JWT ES256, JWKS rotation, S2S signing, and webhooks.",
  "keywords": [
    "auth",
    "sdk",
    "typescript",
    "jwt",
    "jwks",
    "hono",
    "react",
    "cookies",
    "es256",
    "eva",
    "security",
    "oauth",
    "session"
  ],
  "homepage": "https://github.com/eva-solutions-org/auth-sdk#readme",
  "bugs": {
    "url": "https://github.com/eva-solutions-org/auth-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eva-solutions-org/auth-sdk.git",
    "directory": "packages/auth-sdk"
  },
  "license": "MIT",
  "author": "EVA Solutions <arturo.rodas.gonzales@gmail.com>",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/eva-solutions-org"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./hono": {
      "import": {
        "types": "./dist/hono/index.d.ts",
        "default": "./dist/hono/index.js"
      },
      "require": {
        "types": "./dist/hono/index.d.cts",
        "default": "./dist/hono/index.cjs"
      }
    },
    "./generic": {
      "import": {
        "types": "./dist/generic/index.d.ts",
        "default": "./dist/generic/index.js"
      },
      "require": {
        "types": "./dist/generic/index.d.cts",
        "default": "./dist/generic/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react/index.d.ts",
        "default": "./dist/react/index.js"
      },
      "require": {
        "types": "./dist/react/index.d.cts",
        "default": "./dist/react/index.cjs"
      }
    },
    "./hono-openapi": {
      "import": {
        "types": "./dist/hono-openapi/index.d.ts",
        "default": "./dist/hono-openapi/index.js"
      },
      "require": {
        "types": "./dist/hono-openapi/index.d.cts",
        "default": "./dist/hono-openapi/index.cjs"
      }
    },
    "./webhooks": {
      "import": {
        "types": "./dist/webhooks/index.d.ts",
        "default": "./dist/webhooks/index.js"
      },
      "require": {
        "types": "./dist/webhooks/index.d.cts",
        "default": "./dist/webhooks/index.cjs"
      }
    },
    "./admin": {
      "import": {
        "types": "./dist/admin/index.d.ts",
        "default": "./dist/admin/index.js"
      },
      "require": {
        "types": "./dist/admin/index.d.cts",
        "default": "./dist/admin/index.cjs"
      }
    },
    "./s2s": {
      "import": {
        "types": "./dist/s2s/index.d.ts",
        "default": "./dist/s2s/index.js"
      },
      "require": {
        "types": "./dist/s2s/index.d.cts",
        "default": "./dist/s2s/index.cjs"
      }
    },
    "./contracts": {
      "import": {
        "types": "./dist/contracts/index.d.ts",
        "default": "./dist/contracts/index.js"
      },
      "require": {
        "types": "./dist/contracts/index.d.cts",
        "default": "./dist/contracts/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build-with-maps.mjs",
    "dev": "tsdown --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "test:types": "vitest run --typecheck.only",
    "type-check": "tsc --noEmit && tsc -p tests/tsconfig.json",
    "prepublishOnly": "pnpm -w run lint && pnpm -w run fmt:check && pnpm -w run build:contracts && pnpm run type-check && pnpm run test:run && pnpm run build",
    "docs": "typedoc",
    "attw": "attw --pack . --ignore-rules no-resolution",
    "check:self-contained": "node scripts/check-self-contained.mjs dist",
    "check:react-closure": "node scripts/react-closure-size.mjs dist --max 11800 --max-cjs 12380 --forbid \"\\.meta\\(\"",
    "prepack": "pnpm -w run build:contracts && pnpm run build && pnpm run check:self-contained && pnpm run check:react-closure"
  },
  "peerDependencies": {
    "@hono/zod-openapi": ">=1.4.0",
    "hono": ">=4.12.19",
    "react": ">=19.2.6"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@hono/zod-openapi": {
      "optional": true
    }
  },
  "dependencies": {
    "bowser": "^2.15.0",
    "jose": "~6.2.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eva_solutions/auth-contracts": "workspace:*",
    "@hono/zod-openapi": "^1.6.3",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@typhonjs-typedoc/typedoc-theme-dmt": "^0.4.0",
    "expect-type": "^1.4.0",
    "hono": "^4.13.14",
    "react": "^19.3.1",
    "tsdown": "^0.22.14",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "packageManager": "pnpm@11.28.2"
}
