{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.ts",
    "src/hono/index.ts",
    "src/generic/index.ts",
    "src/react/index.ts",
    "src/hono-openapi/index.ts",
    "src/webhooks/index.ts",
    "src/admin/index.ts",
    "src/s2s/index.ts",
    "src/contracts/index.ts"
  ],
  "out": "docs-site",
  "theme": "default-modern",
  "plugin": ["./node_modules/@typhonjs-typedoc/typedoc-theme-dmt/dist/index.js"],
  "exclude": ["**/*.test.ts", "**/*.test-d.ts", "**/tests/**", "**/__tests__/**"],
  "readme": "README.md",
  "name": "EVA Auth SDK",
  "includeVersion": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "githubPages": false,
  "hideGenerator": true,
  "intentionallyNotExported": ["AuthHandlerOptions", "VerifyResult", "EvaAuth"],
  "blockTags": [
    "@param",
    "@returns",
    "@throws",
    "@example",
    "@deprecated",
    "@see",
    "@experimental",
    "@since",
    "@template",
    "@typeParam",
    "@security"
  ]
}
